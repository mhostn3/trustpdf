# Copy to .env in the repository root (next to README.md) and adjust.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Never run with DEBUG=True in production.
DEBUG=False

# Comma-separated hostnames that may serve the site.
ALLOWED_HOSTS=www.trustpdf.net,trustpdf.net

# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://www.trustpdf.net

# Where `manage.py collectstatic` writes files (served by WhiteNoise).
STATIC_ROOT=/home/trustpdf/project/staticfiles

# Optional. Set to an empty value to disable analytics entirely.
# UMAMI_WEBSITE_ID=9ad1d916-d376-4371-b1b1-fafdf77ddaf4

# Optional. Defaults: redirect to HTTPS when DEBUG=False; HSTS for one year.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Optional. Search engine verification: paste only the content="..." value of the meta tag.
# Google Search Console: https://search.google.com/search-console  (choose "HTML tag")
# Bing Webmaster Tools:  https://www.bing.com/webmasters            (or import from Google)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional. IndexNow tells Bing, Yandex, Seznam and Naver about new and changed pages instantly.
# Generate a key once:  python -c "import secrets; print(secrets.token_hex(16))"
# The deploy script then runs `manage.py indexnow` after every successful deploy.
# INDEXNOW_KEY=
